# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/

# Virtual environments
.venv

# Secrets: never commit
.env
.env.*
!.env.example

# Data stays local (raw CMS downloads in data/raw/, app state in data/state.db, letters, anything else) except
# the reference database, which holds only CMS public-use Level II data and is committed.
data/*
!data/claimguard.db
*.db
*.sqlite
*.sqlite3
!data/claimguard.db
# The test fixture database: hand-written rows, our own descriptions.
!tests/fixtures/reference.db

# Frontend
node_modules/
web/dist/

# Local tooling
.DS_Store
.claude/ecc/

# Test coverage output
.coverage
.coverage.*
htmlcov/
.claude/
