{% extends "base.html.j2" %}
{% block body %}
<table>
  <tr><td>Good Faith Estimate</td><td class="money">{{ estimate|money }}</td></tr>
  <tr><td>Amount billed</td><td class="money">{{ billed|money }}</td></tr>
  <tr><td>Difference</td><td class="money">{{ difference|money }}</td></tr>
  <tr><td>Bill date</td><td class="money">{{ bill_date }}</td></tr>
  <tr><td>{{ window_days }}-day deadline</td><td class="money">{{ deadline }}</td></tr>
</table>
{% if window_ended %}
<p>The {{ window_days }}-day window from the bill date ended on {{ deadline }}. I am sending this summary so the difference is on record.</p>
{% else %}
<p>{{ eligibility }}</p>
{% endif %}
<p>Documents to attach:</p>
<ul>
  <li>My Good Faith Estimate</li>
  <li>The itemized bill dated {{ bill_date }}</li>
  <li>Any letter I have sent to the billing office, and any reply</li>
</ul>
{% endblock %}
